{
  "manifest_version": 3,
  "name": "BryNex Portales",
  "version": "1.45.36",
  "description": "Hace los trámites de afiliación de BryNex en los portales de las EPS, cajas y el Fondo de Solidaridad, y trae la exógena de la DIAN a BryNex Renta, con la sesión que la persona abre en su propio navegador.",
  "permissions": [
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://centralaplicaciones.sos.com.co/*",
    "https://www.epssanitas.com/*",
    "https://epssanitas.com/*",
    "https://validate.perfdrive.com/*",
    "https://boxalud.emssanareps.co/*",
    "https://virtual.comfenalcovalle.com.co/*",
    "https://authcomfeempresasprod.web.app/*",
    "https://afiliaciones.sucursalcomfandi.com/*",
    "https://iam.comfandi.com.co/*",
    "https://nelfsp.equiedad.com.co/*",
    "https://brynex.co/*",
    "https://www.brynex.co/*",
    "http://localhost:8000/*",
    "https://muisca.dian.gov.co/*",
    "https://renta.brynex.co/*",
    "http://localhost:8010/*",
    "https://epsapps.suramericana.com/*",
    "https://solucionesenlineaeps.suramericana.com/*",
    "https://login.sura.com/*",
    "https://seus.suramericana.com/*",
    "https://*.suramericana.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://brynex.co/*",
        "https://www.brynex.co/*",
        "http://localhost:8000/*"
      ],
      "js": [
        "puente.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://renta.brynex.co/*",
        "http://localhost:8010/*"
      ],
      "js": [
        "puente-renta.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.epssanitas.com/usuarios/web/nuevo-portal-eps/novedades-afiliacion*",
        "https://epssanitas.com/usuarios/web/nuevo-portal-eps/novedades-afiliacion*"
      ],
      "js": [
        "sanitas-sin-aviso.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}