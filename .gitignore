/.phpunit.cache
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/vendor
.env
# Cualquier variante: respaldos con fecha (.env.antes-del-corte-*), .env.local,
# .env.bak... Todos llevan credenciales de producción en texto plano, y uno
# suelto en el working tree es un commit accidental esperando ocurrir.
# .env.example sí se versiona: no tiene secretos.
.env.*
!.env.example
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log
/.fleet
/.idea
/.vscode
.DS_Store

# Laravel cache / runtime — nunca subir al repo
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/framework/testing/*
!/storage/framework/cache/.gitkeep
!/storage/framework/sessions/.gitkeep
!/storage/framework/views/.gitkeep
!/storage/framework/testing/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep
/bootstrap/cache/*
!/bootstrap/cache/.gitkeep

# Datos personales y archivos de trabajo — NUNCA versionar (Ley 1581 de 2012).
# El repo se auto-despliega a produccion: lo que se versiona, se publica.
/*.xlsx
/*.xls
/*.csv
/*.pdf
/*.log
/*.txt
/cedulas_legacy.txt

# Scripts sueltos de mantenimiento. Lo que haga falta conservar va como
# comando Artisan en app/Console/Commands/, nunca como script en la raiz
# ni dentro de public/.
/tmp_*.php
/diag_*.php
/diagnostico_*.php
/check_*.php
/inspect*.php
/migrate_*.php
/compare-*.php
/run_script.php
/public/*.php
!/public/index.php

# Duplicados generados por sincronizacion en la nube (" 2", " 3")
* 2.*
* 3.*
*\ 2
*\ 3

# Originales PNG de Gemini (pesan 2 MB c/u); al repo van los .jpg
public/img/aliados/*.png
